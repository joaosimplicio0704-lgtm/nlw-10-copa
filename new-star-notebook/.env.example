# ==========================================================
# New Star Notebook — configuração do servidor
# Copie este arquivo para ".env" e ajuste os valores.
# ==========================================================

# Porta e interface do servidor
PORT=3000
HOST=0.0.0.0

# Em produção, coloque atrás de HTTPS (Caddy/Nginx) e use NODE_ENV=production
NODE_ENV=production

# Tempo de validade da sessão (dias)
SESSION_DAYS=30

# Pastas (opcional — por padrão ficam dentro do projeto)
# DATA_DIR=/var/lib/newstar
# BACKUP_DIR=/var/backups/newstar

# Backups automáticos do banco completo no servidor
BACKUP_INTERVALO_HORAS=24
BACKUP_RETER_DIAS=30

# Limite de tentativas de login
LOGIN_MAX_TENTATIVAS=20
LOGIN_JANELA_MIN=15

# ----------------------------------------------------------
# Backup em nuvem (opcional)
# ----------------------------------------------------------
# Opção A: Supabase Storage
# Crie o projeto, pegue a service_role key e, se quiser, o nome do bucket.
# O bucket é criado automaticamente no primeiro envio.
# SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# SUPABASE_SERVICE_KEY=eyJhbGciOi...
# SUPABASE_BUCKET=newstar

# Opção B: WebDAV (Nextcloud, ownCloud, InfiniCLOUD, HiDrive...)
# A URL deve apontar para a pasta onde os backups serão gravados.
# WEBDAV_URL=https://nuvem.exemplo.com/remote.php/dav/files/usuario/newstar
# WEBDAV_USER=usuario
# WEBDAV_PASS=senha-de-app
